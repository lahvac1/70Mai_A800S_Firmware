# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-64-random-hex-characters-000000000000000000000000

# First admin account, created only when the database has no users yet.
ADMIN_USERNAME=admin
# Optional: e-mail of the first admin (gets all notifications, can change on profile)
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me

TZ=Europe/Prague

# Google Drive is connected and its folder chosen in the web UI (Nastavení).
# gdrive:<folder> = initial default folder. Another rclone remote (e.g. :local:/path) overrides the web UI.
DRIVE_REMOTE=gdrive:70mai
# Optional own Google OAuth client ("Web application") for one-click connection in the web UI.
# Authorized redirect URI: <PUBLIC_URL>/settings/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser API key for the folder picker (enable "Google Picker API"; restrict to HTTP referrer <PUBLIC_URL>/*)
GOOGLE_API_KEY=
# Initial server storage limit in GB (0 = unlimited); changed in the web UI.
STORAGE_QUOTA_GB=20
# Placeholders: {device} {folder} {date} {name} {path}
DRIVE_PATH_TEMPLATE={device}/{folder}/{date}/{name}
# Initial default for "keep a copy on the server after Drive upload"; changed in the web UI.
KEEP_LOCAL_COPY=false

# Optional push notifications (ntfy.sh topic or self-hosted ntfy).
NOTIFY_URL=

# SMTP for invitations and notifications. Empty SMTP_HOST = no e-mails.
# Who gets which notification is set by each user on their profile page.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Upload summary is sent after this many seconds without upload activity
MAIL_QUIET_SEC=300
# Invitation link validity in hours
INVITE_TTL_HOURS=168
# Public address of the web UI (links in invitations and e-mails)
PUBLIC_URL=https://dash.firelahva.cz

# Session cookie only over HTTPS. Set false only for local testing over plain HTTP.
COOKIE_SECURE=true

HTTP_PORT=8000

# Host paths for persistent data (absolute or relative to docker-compose.yml).
# DATA_PATH holds the SQLite DB and videos not yet moved to Google Drive.
DATA_PATH=./data
# RCLONE_CONFIG_PATH holds rclone.conf with the Google Drive token.
RCLONE_CONFIG_PATH=./rclone
# Only for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
